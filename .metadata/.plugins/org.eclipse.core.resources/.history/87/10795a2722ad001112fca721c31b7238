@Override
public EventPageResponse searchEvents(String keyword, EventCategory category, EventStatus status, Double minPrice,
		Double maxPrice, int page, int size, String sortBy, String direction) {
	
	
    Sort sort = direction.equalsIgnoreCase("desc")
            ? Sort.by(sortBy).descending()
            : Sort.by(sortBy).ascending();

    Pageable pageable = PageRequest.of(
            page,
            size,
            sort
    );

    Specification<Event> specification =
            Specification.where(
                    EventSpecification.hasKeyword(keyword)
            )
            .and(EventSpecification.hasCategory(category))
            .and(EventSpecification.hasStatus(status))
            .and(EventSpecification.priceGreaterThanOrEqualTo(minPrice))
            .and(EventSpecification.priceLessThanOrEqualTo(maxPrice));

    Page<Event> eventPage =
            repository.findAll(specification, pageable);

    List<EventResponse> content =
            eventPage.getContent()
                    .stream()
                    .map(this::mapToResponse)
                    .toList();

    return EventPageResponse.builder()
            .content(content)
            .page(eventPage.getNumber())
            .size(eventPage.getSize())
            .totalElements(eventPage.getTotalElements())
            .totalPages(eventPage.getTotalPages())
            .last(eventPage.isLast())
            .build();
    }

private EventResponse mapToResponse(Event event) {

    EventResponse response = new EventResponse();
    
    response.setEventId(event.getEventId());
    response.setEventDate(event.getEventDate());
    response.setEventName(event.getEventName());
    response.setEventCategory(event.getEventCategory());
    response.setEventTime(event.getEventTime());
    response.setVenueId(event.getVenueId());
    response.setStatus(event.getEventStatus());
    response.setAvailableSeats(event.getAvailableSeats());
    response.setTotalSeats(event.getTotalSeats());
    response.setTicketPrice(response.getTicketPrice());
    return response;
}

@Override
public EventResponse reserveSeats(Long eventId, Integer noOfSeats) {
	
	Event event = repository.findByEventId(eventId);
	
	if(event==null)
	{
		throw new EventNotFoundException("Event not found with id: "+eventId);
	}
	
	if(event.getEventStatus()==EventStatus.UPCOMING)
	{
		throw new InvalidEventOperationException("Seats cannot reserved for this event");
	}
	
	if(event.getAvailableSeats() < noOfSeats)
	{
		throw new InsufficientSeatsException(
                "Only "
                + event.getAvailableSeats()
                + " seats are available");
	}
	
	event.setAvailableSeats(event.getAvailableSeats()-noOfSeats);
	
	Event updatedEvent = repository.save(event);
	
	return mapToResponse(updatedEvent);
}

