package com.nit.service;

import java.util.List;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.data.domain.Sort;

import com.nit.client.VenueClient;
import com.nit.dto.EventPageResponse;
import com.nit.dto.EventRequest;
import com.nit.dto.EventResponse;
import com.nit.dto.VenueResponse;
import com.nit.entity.Event;
import com.nit.entity.EventStatus;
import com.nit.exception.EventNotFoundException;
import com.nit.exception.InsufficientVenueCapacityException;
import com.nit.exception.VenueNotActiveException;
import com.nit.exception.VenueNotFoundException;
import com.nit.repository.EventRepository;

public class EventServiceImpl implements EventService {

	private final EventRepository repository;
	
	private final VenueClient client;
	
	public EventServiceImpl(EventRepository  repository, VenueClient client)
	{
		this.repository = repository;
		this.client = client;
	}
	
	@Override
	public EventResponse createEvent(EventRequest request) {
		
		VenueResponse venue = client.getVenueById(request.getVenueId());
		
		if(venue==null)
		{
			throw new VenueNotFoundException("Venue are not found with id: "+request.getVenueId());
		}
		
		if(!"Active".equalsIgnoreCase(venue.getStatus()))
		{
			throw new VenueNotActiveException("Venue are not active!");
		}
		
		if(venue.getCapacity()<request.getTotalSeats())
		{
			throw new InsufficientVenueCapacityException("Venue seats are InSufficient!");
		}
		
		 Event event = new Event();
	     event.setEventName(request.getEventName());
	     event.setEventCategory(request.getEventCategory());
	     event.setEventDate(request.getEventDate());
	     event.setEventTime(request.getEventTime());
	     event.setVenueId(request.getVenueId());
	     event.setTotalSeats(request.getTotalSeats());
	     event.setAvailableSeats(request.getTotalSeats());
	     event.setTicketPrice(request.getTicketPrice());
	     event.setEventStatus(EventStatus.UPCOMING);
	     
	     Event savedEvent = repository.save(event);
		return mapToResponse(savedEvent);
	}

	@Override
	public EventResponse getEventById(Long eventId) {
		
		Event event = repository.findById(eventId).orElseThrow(() -> new EventNotFoundException("Event not found with id: "+eventId));
		return mapToResponse(event);
	}

	@Override
	public EventResponse updateEvent(Long eventId, EventRequest request) {
		
		Event event = repository.findById(eventId).orElseThrow(() -> new EventNotFoundException("Event not found with id: "+eventId));
		
		event.setEventName(request.getEventName());
        event.setEventCategory(request.getEventCategory());
        event.setEventDate(request.getEventDate());
        event.setEventTime(request.getEventTime());
        event.setVenueId(request.getVenueId());
        event.setTotalSeats(request.getTotalSeats());
        event.setTicketPrice(request.getTicketPrice());

        Event updatedEvent = repository.save(event);

        return mapToResponse(updatedEvent);
	}

	@Override
	public void deleteEvent(Long eventId) {
		Event event = repository.findById(eventId).orElseThrow(() -> new EventNotFoundException("Event not found with id: "+eventId));
		repository.delete(event);
	}
	
	 @Override
	  public EventPageResponse getEvents(int page, int size, String sortBy, String direction) {
		 
		 Sort sort = direction.equalsIgnoreCase("desc")
				              ? Sort.by(sortBy).descending() 
				              : Sort.by(sortBy).ascending();
		 
		  Pageable pageable = PageRequest.of(page, size, sort);
		  
		  Page<Event> eventPage = repository.findAll(pageable);
		  
		   List<EventResponse> content = eventPage.getContent()
				                                  .stream()
				                                  .map(this::mapToResponse).toList();
		   
		return EventPageResponse.builder()
				    .content(content)
		            .page(eventPage.getNumber())
		            .size(eventPage.getSize())
		            .totalElements(eventPage.getTotalElements())
		            .totalPages(eventPage.getTotalPages())
		            .last(eventPage.isLast())
		            .build();
	  }
	
	
	  private EventResponse mapToResponse(Event event) {

	        EventResponse response = new EventResponse();
	        
	        response.setEventId(event.getEventId());
	        response.setEventDate(event.getEventDate());
	        response.setEventName(event.getEventName());
	        response.setEventCategory(event.getEventCategory());
	        response.setEventTime(event.getEventTime());
	        response.setVenueId(event.getVenueId());
	        response.setStatus(event.getEventStatus());
	        response.setAvailableSeats(event.getAvailableSeats());
	        response.setTotalSeats(event.getTotalSeats());
	        response.setTicketPrice(response.getTicketPrice());
	        return response;
	    }

}
