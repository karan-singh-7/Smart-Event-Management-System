	  private EventResponse mapToResponse(Event event) {

	        EventResponse response = new EventResponse();
	        
	        response.setEventId(event.getEventId());
	        response.setEventDate(event.getEventDate());
	        response.setEventName(event.getEventName());
	        response.setEventCategory(event.getEventCategory());
	        response.setEventTime(event.getEventTime());
	        response.setVenueId(event.getVenueId());
	        response.setStatus(event.getEventStatus());
	        response.setAvailableSeats(event.getAvailableSeats());
	        response.setTotalSeats(event.getTotalSeats());
	        response.setTicketPrice(response.getTicketPrice());
	        return response;
	    }

}
