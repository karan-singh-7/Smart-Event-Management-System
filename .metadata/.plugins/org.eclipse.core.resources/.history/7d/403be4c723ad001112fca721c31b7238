package com.nit.service;

import java.time.LocalDateTime;

import com.nit.client.CustomerClient;
import com.nit.client.EventClient;
import com.nit.dto.BookingRequest;
import com.nit.dto.BookingResponse;
import com.nit.dto.CustomerResponse;
import com.nit.dto.EventResponse;
import com.nit.entity.Booking;
import com.nit.entity.BookingStatus;
import com.nit.repository.BookingRespository;

public class BookingServiceImpl implements BookingService {

	private final BookingRespository repo;
	private final CustomerClient customerClient;
	private final EventClient eventClient;
	
	public BookingServiceImpl(BookingRespository repo, CustomerClient customerClient, EventClient eventClient)
	{
		this.repo=repo;
		this.customerClient=customerClient;
		this.eventClient=eventClient;
	}
	
	
	@Override
	public BookingResponse createBooking(BookingRequest request) {
		
		CustomerResponse customer = customerClient.getCustomerById(request.getCustomerId());
		
		EventResponse event = eventClient.getEventById(request.getEventId());
		
		if(event.getAvailableSeats()<request.getNumberOfSeats())
		{
			throw new RuntimeException("Not enough seat available");
		}
		
		double totalAmount = request.getNumberOfSeats()*event.getTicketPrice();
		
		// create booking
		
		Booking booking = Booking.builder()
				                 .customerId(request.getCustomerId())
				                 .eventId(request.getEventId())
				                 .numberOfSeats(request.getNumberOfSeats())
				                 .totalAmount(totalAmount)
				                 .bookingDate(LocalDateTime.now())
				                 .bookingStatus(BookingStatus.PENDING)
				                 .build();
		
		Booking savedBooking = repo.save(booking);
				                 
		return mapToResponse(savedBooking);
	}
	
	
	private BookingResponse mapToResponse(Booking booking)
	{
		return BookingResponse.builder()
				.bookingId(booking.getBookingId())
                .customerId(booking.getCustomerId())
                .eventId(booking.getEventId())
                .numberOfSeats(booking.getNumberOfSeats())
                .totalAmount(booking.getTotalAmount())
                .bookingDate(booking.getBookingDate())
                .bookingStatus(booking.getBookingStatus())
				.build();              
	}

}
